{
  "agent": {
    "model": "anthropic/claude-sonnet-4-5",
    "thinkingLevel": "medium"
  },
  "agents": {
    "defaults": {
      "workspace": "./workspace"
    }
  },
  "skills": {
    "load": {
      "watch": true,
      "watchDebounceMs": 250
    }
  },
  "security": {
    "shell": {
      "allowlist": [
        "Get-*",
        "Set-*",
        "New-*",
        "Remove-*",
        "Invoke-*",
        "Test-*",
        "az *",
        "git *",
        "npm *",
        "node *",
        "ls",
        "cat",
        "grep",
        "find"
      ],
      "blockPatterns": [
        "rm -rf /",
        ":(){ :|:& };:",
        "> /dev/sda"
      ]
    }
  }
}
